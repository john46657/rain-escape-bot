{
  "name": "nexus",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS — Discord x Roblox Network Platform",
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev:api & npm run dev:dashboard",
    "dev:bot": "npm run dev --workspace @nexus/bot",
    "dev:api": "npm run dev --workspace @nexus/api",
    "dev:dashboard": "npm run dev --workspace @nexus/dashboard",
    "build": "npm run build --workspace @nexus/api && npm run build --workspace @nexus/bot",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate --workspace @nexus/database",
    "db:push": "npm run push --workspace @nexus/database",
    "db:seed": "npm run seed --workspace @nexus/database",
    "bootstrap:dev": "npm run db:generate && npm run db:push && npm run db:seed",
    "deploy:commands": "npm run deploy:commands --workspace @nexus/bot",
    "build:dashboard": "npm run build --workspace @nexus/dashboard",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "check:schema": "node scripts/check-schema.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
