{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "modules/*/src/**/*.ts",
    "apps/bot/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/.next/**", "apps/dashboard/**"]
}
