# ============================================================================
# NEXUS — Beispielkonfiguration
#
# Diese Datei enthaelt KEINE echten Secrets und gehoert ins Repository.
# Kopiere sie nach `.env` und trage dort deine Werte ein (`.env` ist ignoriert).
#
#   cp .env.example .env
#
# Alle Werte mit "CHANGE_ME" muessen vor dem Produktivbetrieb ersetzt werden.
# ============================================================================

# ---- Betriebsmodus ---------------------------------------------------------
NODE_ENV=development
# DEV_MODE=true startet NEXUS ohne PostgreSQL und ohne Redis:
# In-Memory-Datenspeicher + In-Memory-Cache. Nur fuer Entwicklung und Demos.
DEV_MODE=true
# Laedt Demo-Daten in den In-Memory-Store (wirkt nur mit DEV_MODE=true).
DEV_SEED=true
LOG_LEVEL=info
LOG_PRETTY=true

# ---- Discord ---------------------------------------------------------------
# Bot-Token aus dem Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=CHANGE_ME
# Application ID (Developer Portal -> General Information)
DISCORD_CLIENT_ID=CHANGE_ME
# OAuth2 Client Secret (Developer Portal -> OAuth2). Nur fuer das Dashboard noetig.
DISCORD_CLIENT_SECRET=CHANGE_ME
# Testserver: Slash-Commands erscheinen dort sofort statt nach bis zu einer Stunde.
DISCORD_DEV_GUILD_ID=
# Kommagetrennte Discord-IDs mit uneingeschraenkten Rechten.
DISCORD_OWNER_IDS=
# Leer lassen fuer automatisches Sharding.
DISCORD_SHARD_COUNT=

# Benoetigte Privileged Gateway Intents (im Developer Portal aktivieren):
#   SERVER MEMBERS INTENT   — Beitritte, Rollen-Sync, Verifizierung
#   MESSAGE CONTENT INTENT  — AutoMod, XP-Vergabe

# ---- Datenbank -------------------------------------------------------------
# Nur informativ. Der tatsaechliche Provider steht als Literal in
# packages/database/prisma/schema.prisma — Prisma erlaubt dort kein env().
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# ---- Cache / Ereignisbus ---------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=nexus

# ---- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
OAUTH_REDIRECT_URI=http://localhost:4000/auth/callback
API_RATE_LIMIT_PER_MINUTE=120
# Signiert Dashboard-Sessions. Mindestens 32 zufaellige Zeichen:
#   openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_min_32_zufaellige_zeichen

# ---- Roblox ----------------------------------------------------------------
# HMAC-Secret zwischen Game-Server und NEXUS. Gehoert im Spiel in ServerStorage
# und NIEMALS in ReplicatedStorage oder einen LocalScript.
#   openssl rand -hex 32
ROBLOX_SIGNING_SECRET=CHANGE_ME_min_32_zufaellige_zeichen
# Maximal erlaubte Abweichung der Uhren in Sekunden.
ROBLOX_REQUEST_SKEW_SECONDS=300
ROBLOX_RATE_LIMIT_PER_MINUTE=240
ROBLOX_GROUP_SYNC_INTERVAL_MINUTES=30
# Optional: Open-Cloud-Key (creator.roblox.com -> Credentials -> API Keys).
# Ohne Key nutzt NEXUS Polling statt MessagingService-Push — beides funktioniert.
ROBLOX_API_KEY=

# ---- Optionale Integrationen ----------------------------------------------
# KI-Modul (OpenAI-kompatible Chat-Completions-API). Leer = Modul deaktiviert.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Musikmodul benoetigt einen Lavalink-Knoten. Leer = Modul meldet sich als
# nicht konfiguriert (statt eine Funktion vorzutaeuschen).
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
